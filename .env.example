# Browser/API authentication. run.sh generates a random value when blank.
LINGBOT_API_TOKEN=

# Host-only port used by the broker readiness check and local access.
LINGBOT_PORT=8080
# "public" starts Cloudflared; "internal" exposes only the loopback service for
# a trusted caller such as api.noclip.org.
LINGBOT_DEPLOYMENT_MODE=public

# Reproducible upstream checkpoint. Override all integrity fields together for a custom model.
LINGBOT_MODEL_REPO=robbyant/lingbot-map
LINGBOT_MODEL_FILENAME=lingbot-map.pt
LINGBOT_MODEL_REVISION=204754b72bb24f561f8d7e7e1e4e4cd9e809adf9
LINGBOT_MODEL_SHA256=ee665103348e07e6b826d529b8e61de8f413d5432a4f2e84970d6c8fd2e1cd72
LINGBOT_MODEL_SIZE_BYTES=4632303465

# GPU broker scope. Set either the exact UUID or a physical discovery-list index.
# Index 1 is resolved to its UUID before the broker lease and container launch.
# Leave both blank (or set the index to auto) to choose the eligible GPU with
# the most current headroom.
LINGBOT_GPU_UUID=
LINGBOT_GPU_INDEX=
LINGBOT_VRAM_MIB=32768
LINGBOT_READY_TIMEOUT=1800

# Runtime limits for the public tunnel endpoint.
LINGBOT_MAX_UPLOAD_BYTES=94371840
LINGBOT_MAX_FILES=160
LINGBOT_MAX_FRAMES=96
LINGBOT_MAX_QUEUE=4
LINGBOT_RETAIN_JOBS=20
LINGBOT_SCALE_FRAMES=4
LINGBOT_CAMERA_ITERATIONS=1
LINGBOT_USE_SDPA=1

# Empty token = ephemeral Quick Tunnel. For a named tunnel, set both values.
CLOUDFLARE_TUNNEL_TOKEN=
LINGBOT_PUBLIC_URL=

# Optional Hugging Face token for gated/private replacement checkpoints.
HF_TOKEN=
